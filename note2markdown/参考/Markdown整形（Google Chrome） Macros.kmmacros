										<key>Text</key>
										<string>function getNoteBody(options) {
  // オプションが指定されない場合の安全策
  var opts = options || {};
  var asText = opts.asText || false;

  try {
    var bodyDiv = document.querySelector('div[data-name="body"]');
    if (!bodyDiv) return "";
    
    // innerHTML (タグの中身だけ) か textContent (テキストのみ) か
    return asText ? bodyDiv.textContent.trim() : bodyDiv.innerHTML;
  } catch (e) {
    return "";
  }
}

// HTMLごと（内側だけ）欲しい場合
return getNoteBody({ asText: false });
</string>
