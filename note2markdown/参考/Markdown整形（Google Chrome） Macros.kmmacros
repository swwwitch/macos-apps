										<key>Text</key>
										<string>function getPageH1({ asText = false } = {}) {
  try {
    const h1 = document.querySelector('h1.o-noteContentHeader__title');
    if (!h1) return "";
    return asText ? h1.textContent.trim() : h1.outerHTML;
  } catch (e) {
    return "";
  }
}

// テキストだけ欲しい場合
return getPageH1({ asText: true });</string>
