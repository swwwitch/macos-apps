										<string></string>
										<key>Text</key>
										<string>function getSelectionHTML() {
  const selection = window.getSelection &amp;&amp; window.getSelection();
  if (!selection || selection.rangeCount === 0) return '';
  const activeElement = document.activeElement;
  const isTextInput =
    activeElement &amp;&amp;
    ((activeElement.tagName === 'TEXTAREA') ||
     (activeElement.tagName === 'INPUT' &amp;&amp; /^(text|search|url|tel|email|password|number)$/i.test(activeElement.type || '')));

  if (isTextInput &amp;&amp; activeElement.selectionStart != null &amp;&amp; activeElement.selectionEnd != null) {
    const text = activeElement.value.slice(activeElement.selectionStart, activeElement.selectionEnd);
    return text.replace(/[&amp;&lt;&gt;"']/g, ch =&gt; ({
      '&amp;': '&amp;amp;', '&lt;': '&amp;lt;', '&gt;': '&amp;gt;', '"': '&amp;quot;', "'": '&amp;#39;'
    }[ch]));
  }

  const container = document.createElement('div');
  for (let i = 0; i &lt; selection.rangeCount; i++) {
    const range = selection.getRangeAt(i).cloneRange();
    container.appendChild(range.cloneContents());
  }
  return container.innerHTML;
}

return getSelectionHTML();</string>
