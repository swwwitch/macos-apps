					<dict>
						<key>ActionName</key>
						<string>選択した箇所のHTMLコードを取得</string>
						<key>ActionUID</key>
						<integer>19296971</integer>
						<key>CaseEntries</key>
						<array>
							<dict>
								<key>Actions</key>
								<array>
									<dict>
										<key>ActionUID</key>
										<integer>19298381</integer>
										<key>DisplayKind</key>
										<string>Variable</string>
										<key>HonourFailureSettings</key>
										<true/>
										<key>IncludeStdErr</key>
										<false/>
										<key>IncludedVariables</key>
										<array>
											<string>9999</string>
										</array>
										<key>MacroActionType</key>
										<string>ExecuteJavaScript</string>
										<key>Path</key>
										<string></string>
										<key>Text</key>
										<string>function getSelectionHTML() {
  var selection = window.getSelection &amp;&amp; window.getSelection();
  if (!selection || selection.rangeCount === 0) return '';
  
  var activeElement = document.activeElement;
  var isTextInput =
    activeElement &amp;&amp;
    ((activeElement.tagName === 'TEXTAREA') ||
     (activeElement.tagName === 'INPUT' &amp;&amp; /^(text|search|url|tel|email|password|number)$/i.test(activeElement.type || '')));

  if (isTextInput &amp;&amp; activeElement.selectionStart != null &amp;&amp; activeElement.selectionEnd != null) {
    var text = activeElement.value.slice(activeElement.selectionStart, activeElement.selectionEnd);
    return text.replace(/[&amp;&lt;&gt;"']/g, function(ch) {
      var escapeMap = {
        '&amp;': '&amp;amp;',
        '&lt;': '&amp;lt;',
        '&gt;': '&amp;gt;',
        '"': '&amp;quot;',
        "'": '&amp;#39;'
      };
      return escapeMap[ch];
    });
  }

  var container = document.createElement('div');
  for (var i = 0; i &lt; selection.rangeCount; i++) {
    var range = selection.getRangeAt(i).cloneRange();
    container.appendChild(range.cloneContents());
  }
  return container.innerHTML;
}

return getSelectionHTML();
</string>
