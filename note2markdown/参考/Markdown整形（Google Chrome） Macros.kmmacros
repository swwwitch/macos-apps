										<key>MacroActionType</key>
										<string>ExecuteJavaScript</string>
										<key>Path</key>
										<string></string>
										<key>Text</key>
										<string>function getPageH1(options) {
  try {
    // デフォルト値の設定（Safari の古いバージョンでも動作）
    var asText = options &amp;&amp; options.asText !== undefined ? options.asText : false;
    
    var h1 = document.querySelector('h1.o-noteContentHeader__title');
    if (!h1) return "";
    return asText ? h1.textContent.trim() : h1.outerHTML;
  } catch (e) {
    return "";
  }
}

// テキストだけ欲しい場合
return getPageH1({ asText: true });</string>
