						<key>ActionColor</key>
						<string>Orange</string>
						<key>ActionName</key>
						<string>整形（2）JavaScript</string>
						<key>ActionUID</key>
						<integer>19298909</integer>
						<key>Actions</key>
						<array>
							<dict>
								<key>ActionName</key>
								<string>属性削除: class, id, style, name, tabindex, width, height, loading, data, data-xxx</string>
								<key>ActionUID</key>
								<integer>19298910</integer>
								<key>DisplayKind</key>
								<string>Clipboard</string>
								<key>HonourFailureSettings</key>
								<true/>
								<key>IncludeStdErr</key>
								<false/>
								<key>IncludedVariables</key>
								<array>
									<string>9999</string>
								</array>
								<key>MacroActionType</key>
								<string>ExecuteJavaScriptForAutomation</string>
								<key>Path</key>
								<string></string>
								<key>Text</key>
								<string>function run() {
  const kmeApp = Application('Keyboard Maestro Engine');
  // body_content から HTML を取得
  const html = kmeApp.getvariable('body_content');

  let res = html;

  // &lt;nav&gt; 要素を中身ごと削除
  res = res.replace(/&lt;nav[^&gt;]*&gt;[\s\S]*?&lt;\/nav&gt;/gi, "");

  // &lt;button&gt; 要素を中身ごと削除
  res = res.replace(/&lt;button[^&gt;]*&gt;[\s\S]*?&lt;\/button&gt;/gi, "");

  // class="external-article-widget-image" を含む &lt;a&gt; 要素を中身ごと削除
  res = res.replace(/&lt;a[^&gt;]*\bclass\s*=\s*(?:\"[^\"]*external-article-widget-image[^\"]*\"|'[^']*external-article-widget-image[^']*')[^&gt;]*&gt;[\s\S]*?&lt;\/a&gt;/gi, "");

  // &lt;em class="external-article-widget-description"&gt; を中身ごと削除
  res = res.replace(/&lt;em[^&gt;]*\bclass\s*=\s*(?:"[^"]*external-article-widget-description[^"]*"|'[^']*external-article-widget-description[^']*')[^&gt;]*&gt;[\s\S]*?&lt;\/em&gt;/gi, "");

  // &lt;em class="external-article-widget-url"&gt; を中身ごと削除
  res = res.replace(/&lt;em[^&gt;]*\bclass\s*=\s*(?:"[^"]*external-article-widget-url[^"]*"|'[^']*external-article-widget-url[^']*')[^&gt;]*&gt;[\s\S]*?&lt;\/em&gt;/gi, "");

  // 属性削除: class, id, style, name, tabindex, width, height, loading, data, data-xxx
  res = res.replace(/\s*(class|id|style|name|tabindex|width|height|loading|data(?:-[^=\s]+)?)\s*=\s*(\"[^\"]*\"|'[^']*')/gi, "");

  // &lt;div&gt;・&lt;span&gt; のタグだけを削除（中身は残す）
  res = res.replace(/&lt;\/?div[^&gt;]*&gt;/gi, "");
  res = res.replace(/&lt;\/?span[^&gt;]*&gt;/gi, "");

  return res;
}</string>
