										<string>ExecuteJavaScriptForAutomation</string>
										<key>Path</key>
										<string></string>
										<key>Text</key>
										<string>const BetterTouchTool = Application('BetterTouchTool');

const actionConfiguration = {
  BTTActionHUDTitle: '!', // タイトル
  BTTActionHUDDetail: '\nクリップ\nボードは\n空です。', // サブタイトル
  BTTActionHUDDuration: '1.2', // HUDの表示時間（秒）
  BTTActionHUDBackground: '38, 38, 38, 1', // 背景カラー
  BTTActionHUDSlideDirection: 2 // スライドアニメーション
} ;

// スライドアニメーション
// なし
// 1. Slide Up
// 2. Slide Down
// 3. Slide Left
// 4. Slide Right

const actionDefinition = {
  BTTPredefinedActionType: 254,
  BTTHUDActionConfiguration: JSON.stringify(actionConfiguration)
} ;

BetterTouchTool.trigger_action(JSON.stringify(actionDefinition));</string>
