						<string>ExecuteAppleScript</string>
						<key>NotifyOnFailure</key>
						<false/>
						<key>Path</key>
						<string></string>
						<key>StopOnFailure</key>
						<false/>
						<key>Text</key>
						<string>tell application "Keynote"
	if not (exists front document) then return
	
	tell front document
		set selectedItems to selection
		if (count of selectedItems) is less than 2 then return
		
		-- 最小の横幅を取得
		set minWidth to width of item 1 of selectedItems
		repeat with anItem in selectedItems
			set itemWidth to width of anItem
			if itemWidth &lt; minWidth then set minWidth to itemWidth
		end repeat
		
		-- 各オブジェクトの横幅を最小値に揃える
		set modifiedItems to {}
		repeat with anItem in selectedItems
			set itemPos to position of anItem
			set originalWidth to width of anItem
			set width of anItem to minWidth
			set position of anItem to {(item 1 of itemPos) + ((originalWidth - minWidth) / 2), item 2 of itemPos}
			set end of modifiedItems to anItem
		end repeat
		
		-- 元のオブジェクトを再選択
		set selection to modifiedItems
	end tell
end tell</string>
						<key>TimeOutAbortsMacro</key>
						<true/>
						<key>TrimResults</key>
						<true/>
						<key>TrimResultsNew</key>
						<true/>
						<key>UseText</key>
						<true/>
					</dict>
				</array>
