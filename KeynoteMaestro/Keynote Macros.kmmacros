						<key>MacroActionType</key>
						<string>ExecuteAppleScript</string>
						<key>NotifyOnFailure</key>
						<false/>
						<key>Path</key>
						<string></string>
						<key>StopOnFailure</key>
						<false/>
						<key>Text</key>
						<string>tell application "Keynote"
	tell document 1
		repeat with i from 1 to (count of slides)
			set slideRef to slide i
			try
				-- トランジション情報を取得
				set transitionProps to transition properties of slideRef
				set currentEffect to transition effect of transitionProps
				log "スライド " &amp; i &amp; " のトランジション: " &amp; currentEffect
				
				-- Magic Move 以外のトランジションを No Transition に変更
				if currentEffect is not magic move then
					set transition properties of slideRef to {transition effect:no transition effect}
					log "スライド " &amp; i &amp; " のトランジションを No Transition に変更しました。"
				end if
			on error
				log "スライド " &amp; i &amp; " のトランジション情報を取得できませんでした。"
			end try
		end repeat
	end tell
end tell</string>
						<key>TimeOutAbortsMacro</key>
