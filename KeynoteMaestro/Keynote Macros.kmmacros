						<key>Text</key>
						<string>-- 作成日：2025-03-18
-- Keynoteで選択中のオブジェクトの不透明度を0%にする

tell application "Keynote"
	activate
	
	tell front document
		set selectedObjects to selection
		repeat with currentObject in selectedObjects
			try
				set opacity of currentObject to 0
			on error errorMessage
				display dialog "オブジェクトが選択されていません。"
			end try
		end repeat
	end tell
end tell</string>
						<key>TimeOutAbortsMacro</key>
