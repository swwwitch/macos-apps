						<key>Path</key>
						<string></string>
						<key>StopOnFailure</key>
						<false/>
						<key>Text</key>
						<string>tell application "Keynote"
    if not (exists front document) then return
    
    tell front document
        set selectedItems to selection
        if (count of selectedItems) is less than 2 then return
        
        -- 最大の高さを取得
        set maxHeight to 0
        repeat with anItem in selectedItems
            set itemHeight to height of anItem
            if itemHeight &gt; maxHeight then set maxHeight to itemHeight
        end repeat
        
        -- 各オブジェクトの高さを最大値に揃える
        set modifiedItems to {}
        repeat with anItem in selectedItems
            set itemPos to position of anItem
            set height of anItem to maxHeight
            set position of anItem to {item 1 of itemPos, (item 2 of itemPos) - ((height of anItem - maxHeight) / 2)}
            set end of modifiedItems to anItem
        end repeat
        
        -- 元のオブジェクトを再選択
        set selection to modifiedItems
    end tell
end tell</string>
						<key>TimeOutAbortsMacro</key>
