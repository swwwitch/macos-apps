						<array>
							<string>9999</string>
						</array>
						<key>MacroActionType</key>
						<string>ExecuteAppleScript</string>
						<key>NotifyOnFailure</key>
						<false/>
						<key>Path</key>
						<string></string>
						<key>StopOnFailure</key>
						<false/>
						<key>Text</key>
						<string>tell application "Keynote"	-- Keynote にアクティブなプレゼンテーションがあるか確認	if not (exists document 1) then		display dialog "Keynote でプレゼンテーションを開いてください。" buttons {"OK"} default button "OK"		return	end if		tell front document		-- 選択中のスライドを取得		set slideWidth to width		set slideHeight to height		set activeSlide to current slide				-- 新しい図形を作成（スライドと同じ大きさ）		tell activeSlide			make new shape with properties {position:{0, 0}, width:slideWidth, height:slideHeight, opacity:100}		end tell	end tellend tell</string>
						<key>TimeOutAbortsMacro</key>
						<true/>
						<key>TrimResults</key>
						<true/>
						<key>TrimResultsNew</key>
						<true/>
						<key>UseText</key>
						<true/>
					</dict>
				</array>
