						<key>MacroActionType</key>
						<string>ExecuteAppleScript</string>
						<key>Path</key>
						<string></string>
						<key>Text</key>
						<string>tell application "Keynote"
	if not (exists document 1) then
		display dialog "Keynoteのドキュメントが開かれていません。" buttons {"OK"} default button "OK"
		return
	end if
	
	tell document 1
		set currentSlide to current slide
		try
			-- スライドの番号を取得
			set slideIndex to slide number of currentSlide
		on error
			display dialog "スライドの番号を取得できませんでした。" buttons {"OK"} default button "OK"
			return
		end try
		
		set folderPath to (POSIX path of (path to desktop folder)) &amp; "ExportedSlide/"
		
		-- エクスポートフォルダを作成
		do shell script "mkdir -p " &amp; quoted form of folderPath
		
		-- エクスポートする画像のパス
		set exportPath to folderPath &amp; "slide_" &amp; slideIndex &amp; ".png"
		
		-- 現在のスライドを画像としてエクスポート
		try
			export currentSlide to file (POSIX file exportPath) as PNG
			display dialog "現在のスライドをエクスポートしました:
" &amp; exportPath buttons {"OK"} default button "OK"
		on error
			display dialog "スライドのエクスポートに失敗しました。" buttons {"OK"} default button "OK"
		end try
	end tell
end tell</string>
