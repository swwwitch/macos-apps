						<key>Text</key>
						<string>tell application "Keyboard Maestro Engine"
	set kmVarValue to getvariable "opacityValue"
end tell

if kmVarValue is "" then
	display dialog "変数が存在しません。"
else
	try
		set opacityValue to kmVarValue as number
		
		tell application "Keynote"
			tell front document
				set selectedObjects to selection
				repeat with currentObject in selectedObjects
					try
						tell currentObject
							set opacity to opacityValue
						end tell
					on error errorMessage
						display dialog "エラー: " &amp; errorMessage &amp; " オブジェクト: " &amp; (class of currentObject as string)
					end try
				end repeat
			end tell
		end tell
		
	on error
		display dialog "変数の値「" &amp; kmVarValue &amp; "」を数値に変換できません。"
	end try
end if</string>
