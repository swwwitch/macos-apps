						<false/>
						<key>Path</key>
						<string></string>
						<key>StopOnFailure</key>
						<false/>
						<key>Text</key>
						<string>tell application "Keynote"
    tell the front document
        tell the current slide
            -- スライドのサイズを取得
            set slideWidth to width
            set slideHeight to height
            
            -- 垂直線（中央の縦線）を作成
            make new line with properties {start point:{slideWidth / 2, 0}, end point:{slideWidth / 2, slideHeight}, stroke color:{65535, 65535, 65535}, stroke weight:2}
            
            -- 水平線（中央の横線）を作成
            make new line with properties {start point:{0, slideHeight / 2}, end point:{slideWidth, slideHeight / 2}, stroke color:{65535, 65535, 65535}, stroke weight:2}
            
        end tell
    end tell
end tell
</string>
						<key>TimeOutAbortsMacro</key>
						<true/>
						<key>TrimResults</key>
						<true/>
						<key>TrimResultsNew</key>
