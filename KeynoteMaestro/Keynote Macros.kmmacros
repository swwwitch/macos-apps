						<key>Path</key>
						<string></string>
						<key>StopOnFailure</key>
						<false/>
						<key>Text</key>
						<string>-- 作成日：2025-03-18
-- Keynoteで不透明度が0%のオブジェクトを探し、100%に戻す

tell application "Keynote"
	activate
	
	-- 現在のスライドを取得
	set currentSlide to current slide of front document
	
	tell currentSlide
		-- スライド内のすべてのオブジェクトをチェック
		repeat with currentObject in every iWork item
			try
				if opacity of currentObject is 0 then
					set opacity of currentObject to 100
				end if
			on error errorMessage
				display dialog "エラー: " &amp; errorMessage &amp; " オブジェクト: " &amp; (class of currentObject as string)
			end try
		end repeat
	end tell
end tell</string>
						<key>TimeOutAbortsMacro</key>
