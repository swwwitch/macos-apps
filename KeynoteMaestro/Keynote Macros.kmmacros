						<key>Text</key>
						<string>tell application "Keyboard Maestro Engine"
	set kmVarValue to getvariable "scaleValue"
end tell

try
	set scaleValue to kmVarValue as number
on error
	display dialog "変数「scaleValue」が無効です。" buttons {"OK"} default button "OK"
	return
end try

tell application "Keynote"
	if not (exists front document) then return
	
	tell front document
		set selectedItems to selection
		if (count of selectedItems) is 0 then return
		
		-- 変形処理
		set transformedItems to {} -- 変形したアイテムを格納するリスト
		repeat with anItem in selectedItems
			set {w, h, pos} to {width of anItem, height of anItem, position of anItem}
			set newWidth to w * scaleValue
			set newHeight to h * scaleValue
			set position of anItem to {(item 1 of pos) + (w - newWidth) / 2, (item 2 of pos) + (h - newHeight) / 2}
			set {width of anItem, height of anItem} to {newWidth, newHeight}
			
			set end of transformedItems to anItem -- 変形したアイテムをリストに追加
		end repeat
		
		-- 変形後に元のオブジェクトを再選択
		set selection to transformedItems
	end tell
end tell</string>
