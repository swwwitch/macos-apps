		<key>Macros</key>
		<array>
			<dict>
				<key>Actions</key>
				<array>
					<dict>
						<key>ActionUID</key>
						<integer>17438639</integer>
						<key>DisplayKind</key>
						<string>Variable</string>
						<key>HonourFailureSettings</key>
						<true/>
						<key>IncludeStdErr</key>
						<false/>
						<key>IncludedVariables</key>
						<array>
							<string>9999</string>
						</array>
						<key>MacroActionType</key>
						<string>ExecuteAppleScript</string>
						<key>Path</key>
						<string></string>
						<key>Text</key>
						<string>tell application "Keynote"
    if not (exists document 1) then
        return "Keynoteのドキュメントが開かれていません。"
    end if

    tell document 1
        try
            set currentSlide to current slide
            set slideIndex to slide number of currentSlide
            return slideIndex
        on error
            return "スライド番号を取得できませんでした。"
        end try
    end tell
end tell</string>
						<key>TimeOutAbortsMacro</key>
						<true/>
						<key>TrimResults</key>
						<true/>
						<key>TrimResultsNew</key>
						<true/>
						<key>UseText</key>
						<true/>
						<key>Variable</key>
						<string>currentSlideNum</string>
					</dict>
					<dict>
						<key>ActionUID</key>
						<integer>17440449</integer>
						<key>DisplayKind</key>
						<string>Variable</string>
						<key>HonourFailureSettings</key>
						<true/>
						<key>IncludeStdErr</key>
						<false/>
						<key>IncludedVariables</key>
						<array>
							<string>9999</string>
						</array>
						<key>MacroActionType</key>
						<string>ExecuteAppleScript</string>
						<key>Path</key>
						<string></string>
						<key>Text</key>
						<string>tell application "Keynote"
	if not (exists document 1) then return
	
	tell document 1
		try
			set filePath to file of it as alias
			return POSIX path of filePath
		on error
			return ""
		end try
	end tell
end tell</string>
