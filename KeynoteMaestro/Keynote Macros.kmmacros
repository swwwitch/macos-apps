										<key>Text</key>
										<string>tell application "Keynote"
	tell front document
		-- スライドの横幅を取得
		set slideWidth to width
		
		-- 選択中のオブジェクトを取得
		set selectedObjects to selection
		
		-- 選択がない場合はスクリプトを終了
		if (count of selectedObjects) = 0 then return
		
		-- オブジェクトごとに処理
		repeat with currentObject in selectedObjects
			try
				tell currentObject
					set width to slideWidth
				end tell
			end try -- エラーはスルー
		end repeat
	end tell
end tell</string>
