						<key>Text</key>
						<string>tell application "Keynote"
	-- Keynote にアクティブなプレゼンテーションがあるか確認
	if not (exists document 1) then
		display dialog "Keynote でプレゼンテーションを開いてください。" buttons {"OK"} default button "OK"
		return
	end if
	
	tell front document
		-- 選択中のスライドを取得
		set activeSlide to current slide
		
		-- 選択中のオブジェクトを取得
		set selectedObjects to selection
		
		-- オブジェクトが選択されていない場合
		if selectedObjects is {} then
			display dialog "オブジェクトを選択してください。" buttons {"OK"} default button "OK"
			return
		end if
		
		-- 最初の選択オブジェクトの情報を取得
		set firstObject to item 1 of selectedObjects
		set {objX, objY} to position of firstObject
		set objWidth to width of firstObject
		set objHeight to height of firstObject
		
		-- 新しい図形を作成（同じサイズ・同じ位置）
		tell activeSlide
			make new shape with properties {position:{objX, objY}, width:objWidth, height:objHeight, opacity:100}
		end tell
	end tell
end tell</string>
						<key>TimeOutAbortsMacro</key>
						<true/>
						<key>TrimResults</key>
						<true/>
						<key>TrimResultsNew</key>
						<true/>
						<key>UseText</key>
						<true/>
					</dict>
				</array>
