												</array>
												<key>IsActive</key>
												<false/>
												<key>IsDisclosed</key>
												<false/>
												<key>MacroActionType</key>
												<string>ExecuteAppleScript</string>
												<key>Path</key>
												<string></string>
												<key>Text</key>
												<string>tell application "System Events"
	tell process "Firefox"
		set frontWindow to window 1
		set theToolbar to toolbar 1 of frontWindow
		
		repeat with g in groups of theToolbar
			repeat with cb in combo boxes of g
				try
					set urlValue to value of text field 1 of cb
					if urlValue is not "" then return urlValue
				end try
			end repeat
		end repeat
	end tell
end tell</string>
