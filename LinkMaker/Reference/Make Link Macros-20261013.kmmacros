										</array>
										<key>MacroActionType</key>
										<string>ExecuteAppleScript</string>
										<key>NotifyOnFailure</key>
										<false/>
										<key>Path</key>
										<string></string>
										<key>StopOnFailure</key>
										<false/>
										<key>Text</key>
										<string>tell application "Google Chrome"	set {titleList, urlList} to {title, URL} of every tab of window 1	-- UNCOMMENT Next Line to CLOSE FrontMost Window	--close window 1end tellset AppleScript's text item delimiters to linefeedset LF to linefeedset dateISOStr to text 1 thru 10 of ((current date) as «class isot» as string)set tabListStr to "" &amp; LFrepeat with iTab from 1 to (count of urlList)	set tabListStr to tabListStr &amp; LF &amp; (item iTab of titleList) &amp; LF &amp; (item iTab of urlList) &amp; LFend repeatreturn tabListStr</string>
										<key>TimeOutAbortsMacro</key>
