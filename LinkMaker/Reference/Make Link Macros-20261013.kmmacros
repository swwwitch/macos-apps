										<string>https://forum.keyboardmaestro.com/t/get-the-number-of-tabs-open-in-google-chrome/7892/9</string>
									</dict>
									<dict>
										<key>ActionColor</key>
										<string>Teal</string>
										<key>ActionName</key>
										<string>SCRIPT:  Get List of Chrome URLs in FrontMost Window (AS)</string>
										<key>ActionUID</key>
										<integer>15428873</integer>
										<key>DisplayKind</key>
										<string>Clipboard</string>
										<key>HonourFailureSettings</key>
										<true/>
										<key>IncludeStdErr</key>
										<true/>
										<key>IncludedVariables</key>
										<array>
