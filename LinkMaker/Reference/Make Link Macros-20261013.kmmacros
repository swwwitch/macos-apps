												<key>Path</key>
												<string></string>
												<key>Text</key>
												<string>tell application "Google Chrome"
    set tabCount to 0
    repeat with w in windows
        set tabCount to tabCount + (count of tabs of w)
    end repeat
    return tabCount
end tell</string>
