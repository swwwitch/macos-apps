										<key>Path</key>
										<string></string>
										<key>StopOnFailure</key>
										<false/>
										<key>Text</key>
										<string>tell application "Path Finder"
	set selItemList to selection
	if selItemList ≠ missing value then
		repeat with i in selItemList
			set contents of i to (get POSIX path of (contents of i))
		end repeat
	else
		return 0
	end if
end tell
set AppleScript's text item delimiters to linefeed
return selItemList as text</string>
