																		<string>const kmeApp = Application('Keyboard Maestro Engine') ;

const ArrayText = kmeApp.getvariable('ArrayText');
const divider = kmeApp.getvariable('ArrayDivider') ; 
const str = kmeApp.getvariable('ArrayFind'); 

array = ArrayText.split(divider);
array.indexOf(str);</string>
