										<key>Text</key>
										<string>tell application "Path Finder"
    set selItemList to selection
    if selItemList ≠ missing value then
        set firstItemPath to (get POSIX path of (contents of item 1 of selItemList))
        set parentPath to do shell script "dirname " &amp; quoted form of firstItemPath
        return parentPath
    else
        return 0
    end if
end tell</string>
